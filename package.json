{
  "name": "@xrnavigation/webaudio-tinysynth",
  "version": "1.3.0",
  "description": "WebAudio Tiny GM Synthesizer",
  "main": "webaudio-tinysynth.js",
  "types": "webaudio-tinysynth.d.ts",
  "keywords": [
    "midi",
    "webaudio",
    "web-audio",
    "synth"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build": "terser webaudio-tinysynth.js --output webaudio-tinysynth.min.js --compress --source-map",
    "test:package": "node scripts/check-package.cjs",
    "test:browser": "node scripts/check-browser.cjs",
    "check:dist": "npm run build && git diff --exit-code -- webaudio-tinysynth.min.js webaudio-tinysynth.min.js.map"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrnavigation/webaudio-tinysynth.git"
  },
  "author": "Tatsuya Shinyagaito",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/xrnavigation/webaudio-tinysynth/issues"
  },
  "homepage": "https://github.com/xrnavigation/webaudio-tinysynth#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "webaudio-tinysynth.js",
    "webaudio-tinysynth.min.js",
    "webaudio-tinysynth.min.js.map",
    "webaudio-tinysynth.d.ts",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "playwright": "1.56.1",
    "terser": "5.44.1",
    "typescript": "5.9.3",
    "web-audio-engine": "0.13.4"
  }
}
